# Local settings for the Iris server. Copy to .env at the repo root (never committed), fill in what you need.
# The server reads it before any of its settings, so every variable in
# docs/architecture/15-requirements-settings-and-config.md can go here; restart the server after a change.
# Real environment variables win over this file. No quotes around values. A number left empty is the same as unset.

# Gemini on Vertex AI: proposals, chat, plans, patterns, report text, triage, voice and Show it built.
# Vertex AI signs in with Application Default Credentials (`gcloud auth application-default login` locally, the
# service account on Cloud Run). Needed for anything that asks a model.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Local development without a project: a Gemini API key (used only when GOOGLE_CLOUD_PROJECT is empty).
# GEMINI_API_KEY=

# Models by role. Empty takes the defaults in server/iris/model_client.py (DEFAULT_MODELS).
# Main model: understanding, proposals, chat, plans, report text.
# GEMINI_MODEL=gemini-4-argon
# Bulk triage, clash titles, STEP part names and voice transcription.
# GEMINI_FAST_MODEL=gemini-3.8-flash
# Second, longer try at a clash the main model found no verified fix for; also judges Show it built pictures.
# GEMINI_ESCALATION_MODEL=gemini-4-argon
# Show it built: restyles Iris's view of a fix as a presentation render.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Thinking level: minimal | low | medium | high, or empty for the model's default.
GEMINI_THINKING_LEVEL=low
# GEMINI_FAST_THINKING_LEVEL=
# GEMINI_ESCALATION_THINKING_LEVEL=high
# A day's spend cap for second tries and Show it built judges, in USD.
# IRIS_ESCALATION_MAX_USD_DAY=25
# IRIS_TRIAGE_WORKERS=8

# Owner settings (gear in the header, open the page with #owner). At least 24 characters; make one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
IRIS_OWNER_TOKEN=
# Web app on another origin (Firebase Hosting): its origins, comma-separated. Empty: web app and API on one origin.
# IRIS_ALLOWED_ORIGINS=

# Demo caps (the Cloud Run deploy sets them, deploy/env.yaml). 0 is no limit. Unset or empty takes the default,
# which is no limit, except new requirements files (120 an hour per visitor) and requirement previews (60 an hour per
# visitor).
# IRIS_PROPOSE_PER_HOUR=20
# IRIS_PROPOSE_PER_DAY=300
# IRIS_CHAT_PER_HOUR=40
# IRIS_CHAT_PER_DAY=1500
# IRIS_VOICE_PER_HOUR=60
# IRIS_VOICE_PER_DAY=2000
# IRIS_REQUIREMENTS_PER_HOUR=120
# IRIS_PREVIEW_PER_HOUR=60
# Live voice: how long a hands-free session may keep the mic open (hold to talk is 60 s).
# IRIS_VOICE_LIVE_MAX_S=120

# Wider-fix search bounds. Positive values can lower these hard ceilings; owner settings keep these limits.
# IRIS_CONTEXT_MODEL_CALLS=6
# IRIS_CONTEXT_TRIALS=12
# IRIS_CONTEXT_SECONDS=120
# IRIS_CONTEXT_ALTERNATIVES=3
# IRIS_CONTEXT_RADIUS_M=2.5
