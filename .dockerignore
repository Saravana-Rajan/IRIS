# Build context for the root Dockerfile. Keep secrets and local state out of the image.
.env
.env.*
!.env.example
.git
.gitattributes
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.venv
**/node_modules
web/dist
web/public/wasm
server/.iris-settings.json
server/tests
web/tests
web/spikes
spikes
evals
docs
assets
deploy
*.md
!web/**/*.md

# samples/: only what the demo serves (models, sample clash reports and their images, the STEP conversion cache).
samples/**
!samples/**/*.ifc
!samples/**/*.IFC
!samples/**/*.step
!samples/**/*.STEP
!samples/**/*.stp
!samples/**/*.STP
!samples/**/*.json
!samples/**/*.xml
!samples/**/*.png
!samples/**/*.jpg
!samples/**/*.jpeg
